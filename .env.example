# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst
POSTGRES_DB=filings
POSTGRES_PORT=5432
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/filings

# Models: claude-haiku-5-5 (cheapest, default) | claude-sonnet-5-5 | claude-opus-5-5
ANSWER_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-haiku-5-5

# Optional tracing (https://cloud.langfuse.com, free tier). Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
